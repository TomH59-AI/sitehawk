{
  "name": "Auto-add Targets to CRM",
  "description": "Whenever a SCIP's parcel targets are set or changed, automatically create a SCIP CRM deal and one CRM contact per Target (A/B/C) for the owner. Idempotent \u2014 never recreates a contact the user deleted.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ScipRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_add_targets_to_crm",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCrmFromTargets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}