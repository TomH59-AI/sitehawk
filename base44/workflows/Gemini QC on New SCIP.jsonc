{
  "description": "Immediately runs OpenRouter GPT-5.6 Sol quality control and evidence-backed repair after a SCIP record is created. It applies only validated repairs, reruns the full deterministic audit, and permits printing only on PASS.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "openrouter_qc_repair_on_new_scip",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_openrouter_qc": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scipBookQc",
            "args": {
              "scip_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run OpenRouter SCIP QC + Repair",
            "description": "Repair, re-audit, and gate release"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ScipRecord"
    }
  },
  "name": "OpenRouter QC + Repair on New SCIP"
}