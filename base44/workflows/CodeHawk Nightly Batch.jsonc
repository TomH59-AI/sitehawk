{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "CodeHawk Nightly Batch",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "codehawk_nightly_batch",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "codehawk_batch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "codehawkBatch",
            "args": {
              "scheduled": true,
              "batch_size": 25,
              "mode": "backfill",
              "cooldown_days": 30,
              "concurrency": 2,
              "time_budget_ms": 240000,
              "max_scrapfly_calls": 50,
              "scrapfly_asp_cost_budget": 50
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run the CodeHawk backfill batch",
            "description": "25 jurisdictions, weakest and stalest first, with a 50-call Scrapfly ceiling"
          }
        }
      }
    ]
  },
  "description": "Runs the CodeHawk Super Agent pipeline against 25 jurisdictions a night, prioritising registry records missing one or more of the six critical tower-siting values. Retrieval is registry/cache first, then direct, then tiered cached Scrapfly (plain, browser, ASP) with a hard 50-call run ceiling and per-request ASP budget; OxyLabs remains the final fallback. The retrieved text goes through cited extraction and an adversarial quality-control pass. Anything unproven goes to the admin review queue. A 30-day cooldown prevents re-grinding jurisdictions whose codes simply do not state a rule."
}