{
  "name": "ScipRecord",
  "type": "object",
  "description": "SkyWave SCIP Step 1 \u2014 Site Acquisition & Search Ring record. Drives the printable SCIP document.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description or notes for this record (up to 1000 characters).",
      "maxLength": 1000
    },
    "agent_name": {
      "type": "string",
      "description": "Agent full name (max 80 chars)"
    },
    "agent_phone": {
      "type": "string",
      "description": "Agent phone, formatted (XXX) XXX-XXXX"
    },
    "agent_email": {
      "type": "string",
      "description": "Agent email"
    },
    "submittal_date": {
      "type": "string",
      "format": "date",
      "description": "Submittal date"
    },
    "site_name": {
      "type": "string",
      "description": "Site candidate name, e.g. SW-TX-0142 (Karnes City)"
    },
    "latitude": {
      "type": "number",
      "description": "Site latitude (-90 to 90)"
    },
    "longitude": {
      "type": "number",
      "description": "Site longitude (-180 to 180)"
    },
    "search_radius": {
      "type": "string",
      "enum": [
        "0.25",
        "0.50",
        "1.00"
      ],
      "default": "1.00",
      "description": "Selected SARF search radius in miles"
    },
    "sarf_height": {
      "type": "number",
      "description": "SARF height in feet AGL (1-2000)"
    },
    "county": {
      "type": "string",
      "description": "County (optional)"
    },
    "state": {
      "type": "string",
      "description": "2-letter US state code, uppercase (optional)"
    },
    "map_image_url": {
      "type": "string",
      "description": "Generated Mapbox static SARF map PNG URL"
    },
    "zoning_jurisdiction": {
      "type": "string",
      "description": "Resolved local governing authority for zoning"
    },
    "zoning_report": {
      "type": "object",
      "description": "Filled-out Zoning & Permitting worksheet \u2014 each row is { value, source, confidence }"
    },
    "hawk_maps": {
      "type": "object",
      "description": "HAWK MAPS suite for the active target \u2014 Aerial, Topography, Floodplain and Zoning static map PNGs.",
      "properties": {
        "aerial_url": {
          "type": "string",
          "description": "Mapbox satellite aerial map of the target."
        },
        "topography_url": {
          "type": "string",
          "description": "Mapbox terrain/topography map of the target."
        },
        "floodplain_url": {
          "type": "string",
          "description": "Aerial map with FEMA NFHL flood zone overlay."
        },
        "zoning_url": {
          "type": "string",
          "description": "Light basemap with Zoneomics zoning overlay."
        },
        "zone_code": {
          "type": "string",
          "description": "Zoneomics zone code resolved for the target."
        },
        "center_amsl_ft": {
          "type": "number",
          "description": "USGS 3DEP ground elevation AMSL (ft) at the target centroid."
        }
      }
    },
    "power_airport_maps": {
      "type": "object",
      "description": "Two Target A maps \u2014 nearest electric provider/transmission line (power) and nearest airport (crow-flies distance).",
      "properties": {
        "power": {
          "type": "object",
          "description": "Power map URL + provider company name, contact address, phone, website, distance, and transmission-line owner/voltage context."
        },
        "airport": {
          "type": "object",
          "description": "Airport map URL + nearest airport name/type and crow-flies distance (miles & feet)."
        }
      }
    },
    "rf_enrichment": {
      "type": "object",
      "description": "RF proximity + coverage enrichment for the active Target A, KEYED BY active_target_index (string key, e.g. {\"0\": {...}}). Promoting a backup target to Target A uses a new index slot, so its enrichment regenerates rather than reusing stale data. Each slot: { target_index, target_lat, target_lon, radius_miles, tower_height_ft, generated_at, rf:{ airport, tower, rf, error }, coverage:{ png_url, bounds, key_data, area_covered_sq_km, max_range_km, error } }.",
      "additionalProperties": true
    },
    "section_target_index": {
      "type": "object",
      "description": "Maps each SCIP section_key to the active_target_index it was last generated for (e.g. { \"hawk_maps\": 0, \"viewshed\": 0 }). When active_target_index changes, any section whose stamp no longer matches is stale and should be regenerated. Sections that key their own output by index (rf_enrichment) do not need a stamp here.",
      "additionalProperties": true
    },
    "parcel_targets": {
      "type": "array",
      "description": "Top 3 candidate parcels (Target A/B/C) chosen from all parcels in the ring, scored against tower-siting criteria. Index 0 = Target A (the SCIP focus).",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Target A | Target B | Target C"
          },
          "owner_name": {
            "type": "string"
          },
          "parcel_address": {
            "type": "string"
          },
          "parcel_city": {
            "type": "string",
            "description": "Situs city returned by the parcel data source."
          },
          "apn": {
            "type": "string"
          },
          "acreage": {
            "type": "number"
          },
          "boundaries": {
            "type": "string",
            "description": "Frontage x depth or legal boundary summary"
          },
          "zoning_classification": {
            "type": "string"
          },
          "mailing_address": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "fema_risk_factor": {
            "type": "string",
            "description": "FEMA flood zone code + risk level"
          },
          "score": {
            "type": "number",
            "description": "0-100 siting suitability score"
          },
          "score_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Why this parcel scored as it did"
          },
          "land_use": {
            "type": "string"
          }
        }
      }
    },
    "active_target_index": {
      "type": "number",
      "default": 0,
      "description": "Which parcel_targets index the SCIP is currently focused on (0 = Target A). Advance when a target is turned down."
    },
    "existing_conditions": {
      "type": "object",
      "description": "Existing Conditions worksheet for the active target (Target A). Generated from FEMA, USFWS NWI, OSM and web-grounded research.",
      "properties": {
        "flood_zone": {
          "type": "string",
          "description": "FEMA flood zone(s)"
        },
        "wetland_concerns": {
          "type": "string",
          "description": "Wetland concerns (USFWS NWI)"
        },
        "water_management_district": {
          "type": "string",
          "description": "Governing water management district / agency"
        },
        "hazardous_waste": {
          "type": "string",
          "description": "Known hazardous waste / brownfield / Superfund concerns"
        },
        "access_notes": {
          "type": "string",
          "description": "Access notes \u2014 ROW, driveway, easement, road frontage"
        },
        "local_police": {
          "type": "string",
          "description": "Local police municipality & phone"
        },
        "local_fire": {
          "type": "string",
          "description": "Local fire department municipality & phone"
        }
      }
    },
    "viewshed": {
      "type": "object",
      "description": "Viewshed Analysis for Target A. Mapbox aerial ring image plus N/S/E/W tree-line viewshed maps and USGS elevation profiles for RF line-of-sight obstruction assessment.",
      "properties": {
        "aerial_ring_url": {
          "type": "string",
          "description": "Mapbox aerial image centered on Target A with the colored radius ring and tower-location waypoint marker."
        },
        "tower_height_ft": {
          "type": "number",
          "description": "Tower height (ft AGL) used for the line-of-sight calculation."
        },
        "directions": {
          "type": "array",
          "description": "Four cardinal viewshed entries (N/S/E/W).",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "North from Site | South from Site | East from Site | West from Site"
              },
              "short": {
                "type": "string",
                "description": "N | S | E | W"
              },
              "bearing": {
                "type": "number",
                "description": "Compass bearing in degrees (0/90/180/270)"
              },
              "color": {
                "type": "string",
                "description": "Hex color for this direction's cone/profile"
              },
              "map_url": {
                "type": "string",
                "description": "Mapbox pitched 2D viewshed map URL for this direction."
              },
              "profile": {
                "type": "array",
                "description": "USGS elevation profile samples along the bearing.",
                "items": {
                  "type": "object",
                  "properties": {
                    "dist_mi": {
                      "type": "number",
                      "description": "Distance from tower in miles."
                    },
                    "ground_ft": {
                      "type": "number",
                      "description": "Ground elevation AMSL in feet."
                    },
                    "los_ft": {
                      "type": "number",
                      "description": "RF line-of-sight elevation AMSL in feet at this distance."
                    },
                    "obstructed": {
                      "type": "boolean",
                      "description": "True if ground (plus assumed tree line) rises above the line-of-sight."
                    }
                  }
                }
              },
              "first_obstruction_mi": {
                "type": "number",
                "description": "Distance to the first obstruction in miles (null if clear)."
              },
              "clear": {
                "type": "boolean",
                "description": "True if line-of-sight is clear for the full corridor."
              }
            }
          }
        }
      }
    },
    "owner_contacts": {
      "type": "object",
      "description": "Hawk Skip-Trace results persisted onto the SCIP so the Document Studio owner-access block always carries the retrieved owner phone(s) and email(s).",
      "properties": {
        "best_phone": {
          "type": "string"
        },
        "best_email": {
          "type": "string"
        },
        "is_entity_owner": {
          "type": "boolean"
        },
        "traced_at": {
          "type": "string",
          "format": "date-time"
        },
        "phones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phone": {
                "type": "string"
              },
              "display": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source_count": {
                "type": "number"
              },
              "mobile": {
                "type": "boolean"
              }
            }
          }
        },
        "emails": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source_count": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "notion_snapshot_sync": {
      "type": "boolean",
      "default": false,
      "description": "Toggle \u2014 'Sync snapshot summaries to Notion'. When true, DataSourceSnapshot creates/refreshes are optionally mirrored to a human-readable Notion audit database. Notion is a review mirror only; Base44 remains the source of truth and sync failures never block SCIP work."
    },
    "governing_jurisdiction_id": {
      "type": "string",
      "description": "JurisdictionRegistry id of the primary governing local jurisdiction matched to this SCIP."
    },
    "zoning_jurisdiction_id": {
      "type": "string",
      "description": "JurisdictionRegistry id of the jurisdiction controlling ZONING (may equal governing_jurisdiction_id)."
    },
    "permitting_jurisdiction_id": {
      "type": "string",
      "description": "JurisdictionRegistry id of the jurisdiction controlling BUILDING PERMITS \u2014 kept separate because a municipality may control zoning while the county controls permits."
    },
    "jurisdiction_match_confidence": {
      "type": "number",
      "description": "0-100 confidence of the parcel-to-jurisdiction match."
    },
    "jurisdiction_match_method": {
      "type": "string",
      "enum": [
        "parcel_data",
        "GIS_boundary",
        "geocoding",
        "manual_selection"
      ],
      "description": "How the jurisdiction was matched."
    },
    "jurisdiction_review_required": {
      "type": "boolean",
      "default": false,
      "description": "True when the match was manual or low-confidence \u2014 flagged for admin review in the Jurisdiction Resource Manager."
    },
    "book_qc": {
      "type": "object",
      "description": "SCIP Book Gemini QC results: { filled: {field_key: verified value}, needs_human: [{key,label,why}], summary, ran_at, ran_by }. Filled values overlay blank fields in the SCIP Book viewer and printed package; needs_human lists fields a person must complete before client delivery. Written by the scipBookQc backend function.",
      "additionalProperties": true
    },
    "gsheet": {
      "type": "object",
      "description": "Live Google Sheets SCIP built on the NEW SCIP 8.1.2026 eight-page template: { spreadsheet_id, url, pdf_url, synced_at }. Created/refreshed by the scipBookSheet backend function via the shared Google Sheets connector (anyone-with-link readable). url = live shareable spreadsheet; pdf_url = 8.5x11 letter PDF export link.",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "map_generated",
        "submitted"
      ],
      "default": "draft",
      "description": "Record status"
    }
  },
  "required": [
    "agent_name",
    "agent_phone",
    "agent_email",
    "submittal_date",
    "site_name",
    "latitude",
    "longitude",
    "search_radius",
    "sarf_height"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}