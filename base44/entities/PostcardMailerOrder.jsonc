{
  "name": "PostcardMailerOrder",
  "type": "object",
  "description": "A paid Postcard Mailer Pack order tied to one ScipRecord. Recipients are the SCIP's parcel_targets plus optional already-evaluated parcels. Lob postcards are created server-side only after payment is confirmed.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scip_record_id": {
      "type": "string",
      "description": "The ScipRecord this mailer order belongs to."
    },
    "site_name": {
      "type": "string"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "scip_target",
              "extra"
            ],
            "default": "scip_target"
          },
          "owner_name": {
            "type": "string"
          },
          "mailing_address": {
            "type": "string"
          },
          "parcel_address": {
            "type": "string"
          },
          "apn": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "address_verified": {
            "type": "boolean",
            "default": false
          },
          "verification_note": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "address_verified",
              "pending_payment",
              "sent",
              "failed",
              "canceled"
            ],
            "default": "draft"
          },
          "lob_postcard_id": {
            "type": "string"
          },
          "expected_delivery": {
            "type": "string"
          },
          "tracking_url": {
            "type": "string"
          },
          "failure_reason": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          }
        }
      }
    },
    "message_copy": {
      "type": "string"
    },
    "sender": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "branding_mode": {
          "type": "string",
          "enum": [
            "sitehawk",
            "customer"
          ],
          "default": "sitehawk"
        },
        "logo_url": {
          "type": "string"
        }
      }
    },
    "recipient_count": {
      "type": "number"
    },
    "price_charged_usd": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "failed",
        "canceled"
      ],
      "default": "pending_payment"
    },
    "mailing_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_payment",
        "processing",
        "sent",
        "partial",
        "failed",
        "canceled"
      ],
      "default": "draft"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "lob_mode": {
      "type": "string",
      "enum": [
        "TEST",
        "LIVE"
      ]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "scip_record_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}