{
  "name": "PostcardMailerOrder",
  "type": "object",
  "description": "A paid Postcard Mailer Pack order tied to one ScipRecord. Recipients are the SCIP's parcel_targets (Target A/B/C) plus up to 2 optional extra already-evaluated parcels. Lob postcards are created server-side only after payment is confirmed; Lob postcard IDs/statuses are stored per recipient. Never stores Lob credentials.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description or notes for this record (up to 1000 characters).",
      "maxLength": 1000
    },
    "scip_record_id": {
      "type": "string",
      "description": "The ScipRecord this mailer order belongs to."
    },
    "site_name": {
      "type": "string",
      "description": "Cached SCIP site name for display."
    },
    "recipients": {
      "type": "array",
      "description": "The selected postcard recipients with their per-recipient mailing data and status.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Target A | Target B | Target C | Extra 1 | Extra 2"
          },
          "source": {
            "type": "string",
            "enum": [
              "scip_target",
              "extra"
            ],
            "default": "scip_target",
            "description": "Whether this recipient is a SCIP parcel_target or an optional extra evaluated parcel."
          },
          "owner_name": {
            "type": "string"
          },
          "mailing_address": {
            "type": "string",
            "description": "Owner mailing address used for the postcard To field."
          },
          "parcel_address": {
            "type": "string",
            "description": "Site / situs address (display only)."
          },
          "apn": {
            "type": "string",
            "description": "Parcel / APN identifier."
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "address_verified": {
            "type": "boolean",
            "default": false,
            "description": "True if Lob US address verification deliverable."
          },
          "verification_note": {
            "type": "string",
            "description": "Lob deliverability summary or failure reason."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "address_verified",
              "pending_payment",
              "sent",
              "failed",
              "canceled"
            ],
            "default": "draft",
            "description": "Per-recipient mailing status."
          },
          "lob_postcard_id": {
            "type": "string",
            "description": "Lob postcard ID once mailed."
          },
          "expected_delivery": {
            "type": "string",
            "description": "Lob expected_delivery_date."
          },
          "tracking_url": {
            "type": "string",
            "description": "Lob postcard URL/tracking if available."
          },
          "failure_reason": {
            "type": "string",
            "description": "Reason this recipient failed, if any."
          },
          "idempotency_key": {
            "type": "string",
            "description": "Idempotency key used for the Lob create call to prevent duplicate sends."
          }
        }
      }
    },
    "message_copy": {
      "type": "string",
      "description": "The edited postcard body copy (HawkBot-drafted or user-typed) printed on the back of every postcard."
    },
    "sender": {
      "type": "object",
      "description": "The user's private-label contact block printed on the postcard.",
      "properties": {
        "name": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "recipient_count": {
      "type": "number",
      "description": "Number of recipients in this order."
    },
    "price_charged_usd": {
      "type": "number",
      "description": "Amount charged for this order (USD)."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "failed",
        "canceled"
      ],
      "default": "pending_payment",
      "description": "Order-level payment status."
    },
    "mailing_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_payment",
        "processing",
        "sent",
        "partial",
        "failed",
        "canceled"
      ],
      "default": "draft",
      "description": "Order-level mailing status rollup."
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout session id for this order."
    },
    "lob_mode": {
      "type": "string",
      "enum": [
        "TEST",
        "LIVE"
      ],
      "description": "Which Lob environment the postcards were created in."
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the postcards were created in Lob."
    }
  },
  "required": [
    "scip_record_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}