{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "tier": {
      "type": "string",
      "description": "Subscription tier",
      "enum": [
        "blind",
        "monthly",
        "annual"
      ],
      "default": "blind"
    },
    "subscription_plan": {
      "type": "string",
      "description": "Active Stripe subscription plan"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "trial_scans_remaining": {
      "type": "number",
      "description": "Number of free trial scans remaining",
      "default": 0
    },
    "free_trial_used": {
      "type": "boolean",
      "description": "Whether the user has used their one free full trial scan",
      "default": false
    },
    "free_trial_skip_trace_used": {
      "type": "boolean",
      "description": "Whether the user has used their one free skip trace included with the trial",
      "default": false
    },
    "pending_propositions": {
      "type": "object",
      "description": "Keyed map of in-flight single-landlord proposition letter drafts awaiting Stripe payment. Cleared after Lob fulfillment."
    }
  },
  "required": [
    "role"
  ]
}