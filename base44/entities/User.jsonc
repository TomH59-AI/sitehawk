{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "demo"
      ]
    },
    "tier": {
      "type": "string",
      "description": "Subscription tier matching the billing quota tiers.",
      "enum": [
        "free",
        "hawk_site",
        "hawkeyes",
        "hawkeye_apex",
        "enterprise_trial",
        "demo"
      ],
      "default": "free"
    },
    "subscription_plan": {
      "type": "string",
      "description": "Active Stripe subscription plan"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "trial_scans_remaining": {
      "type": "number",
      "description": "Number of free trial scans remaining",
      "default": 0
    },
    "free_trial_used": {
      "type": "boolean",
      "description": "Whether the user has used their one free full trial scan",
      "default": false
    },
    "free_trial_skip_trace_used": {
      "type": "boolean",
      "description": "Whether the user has used their one free skip trace included with the trial",
      "default": false
    },
    "pending_propositions": {
      "type": "object",
      "description": "Keyed map of in-flight single-landlord proposition letter drafts awaiting Stripe payment."
    },
    "hawk_compliance_active": {
      "type": "boolean",
      "description": "True if the user has an active Hawk Compliance subscription.",
      "default": false
    },
    "enterprise_trial_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when the enterprise_trial tier expires."
    },
    "demo_disabled": {
      "type": "boolean",
      "description": "Admin-set flag to instantly cut off a demo account.",
      "default": false
    },
    "demo_label": {
      "type": "string",
      "description": "Human-readable label for this demo slot."
    },
    "demo_trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when the demo user ran their first SCIP. The 5-day demo window starts from this timestamp."
    }
  },
  "required": [
    "role"
  ]
}