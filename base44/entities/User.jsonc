{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "demo"
      ]
    },
    "tier": {
      "type": "string",
      "description": "Subscription tier: hawk_site | hawk_site_law | hawk_vision | hawk_vision_law | hawk_command | free",
      "enum": [
        "free",
        "hawk_site",
        "hawk_site_law",
        "hawk_vision",
        "hawk_vision_law",
        "hawk_command",
        "hawkeyes",
        "hawkeye_apex",
        "enterprise_trial",
        "demo"
      ],
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "description": "Stripe subscription status",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "canceled",
        "incomplete",
        "unknown"
      ],
      "default": "unknown"
    },
    "subscription_plan": {
      "type": "string",
      "description": "Active Stripe subscription plan label"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "stripe_current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when current billing period ends (next billing date)"
    },
    "hawk_law_free_triage_used": {
      "type": "boolean",
      "description": "True if the user has used their one lifetime free Hawk Law triage session",
      "default": false
    },
    "trial_scans_remaining": {
      "type": "number",
      "description": "Number of free trial scans remaining",
      "default": 0
    },
    "free_trial_used": {
      "type": "boolean",
      "description": "Whether the user has used their one free full trial scan",
      "default": false
    },
    "free_trial_skip_trace_used": {
      "type": "boolean",
      "description": "Whether the user has used their one free skip trace included with the trial",
      "default": false
    },
    "pending_propositions": {
      "type": "object",
      "description": "Keyed map of in-flight single-landlord proposition letter drafts awaiting Stripe payment."
    },
    "hawk_compliance_active": {
      "type": "boolean",
      "description": "True if the user has an active Hawk Compliance subscription.",
      "default": false
    },
    "enterprise_trial_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when the enterprise_trial tier expires."
    },
    "demo_disabled": {
      "type": "boolean",
      "description": "Admin-set flag to instantly cut off a demo account.",
      "default": false
    },
    "demo_label": {
      "type": "string",
      "description": "Human-readable label for this demo slot."
    },
    "demo_trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when the demo user ran their first SCIP. The 5-day demo window starts from this timestamp."
    }
  },
  "required": [
    "role"
  ]
}