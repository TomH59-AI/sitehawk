{
  "name": "PSAP",
  "type": "object",
  "description": "911 Master PSAP (Public Safety Answering Point) Registry. Source: FCC 911 Master PSAP Registry. Used to identify the nearest 911 dispatch / public-safety answering point for a site. NOTE: the FCC registry publishes NO phone numbers \u2014 non-emergency numbers must come from PublicSafetyAgency / verified research, never inferred here. Coordinates are city-level geocodes from the registry, not the PSAP's exact street location.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description or notes for this record (up to 1000 characters).",
      "maxLength": 1000
    },
    "psap_id": {
      "type": "string",
      "description": "PSAP ID from the FCC registry."
    },
    "psap_name": {
      "type": "string",
      "description": "PSAP name."
    },
    "county": {
      "type": "string",
      "description": "County."
    },
    "city": {
      "type": "string",
      "description": "City."
    },
    "state": {
      "type": "string",
      "description": "Two-letter state code."
    },
    "type_of_change": {
      "type": "string",
      "description": "Type of Change (full text) from the registry."
    },
    "date_last_modified": {
      "type": "string",
      "description": "Date last modified (may be blank)."
    },
    "geocode_city_level": {
      "type": "string",
      "description": "Raw 'Geocode City Level' value as provided (may contain embedded coordinates)."
    },
    "latitude": {
      "type": "number",
      "description": "City-level latitude parsed verbatim from geocode_city_level. Blank when the registry publishes no coordinate \u2014 never estimated."
    },
    "longitude": {
      "type": "number",
      "description": "City-level longitude parsed verbatim from geocode_city_level. Blank when the registry publishes no coordinate \u2014 never estimated."
    },
    "source": {
      "type": "string",
      "default": "FCC 911 Master PSAP Registry",
      "description": "Data source, displayed for attribution."
    }
  },
  "required": [
    "psap_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}