{
  "name": "SearchHistory",
  "type": "object",
  "properties": {
    "latitude": {
      "type": "number",
      "description": "Search center latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Search center longitude"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "results_count": {
      "type": "number",
      "default": 0
    },
    "search_label": {
      "type": "string",
      "description": "Auto-generated label for the search"
    },
    "ordinance_metadata": {
      "type": "object",
      "description": "Verified local ordinance extraction metadata, including telecom tower and antenna zoning clauses"
    }
  },
  "required": [
    "latitude",
    "longitude"
  ]
}