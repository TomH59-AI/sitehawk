{
  "name": "Voicemail",
  "type": "object",
  "properties": {
    "call_sid": {
      "type": "string",
      "description": "Twilio Call SID \u2014 unique ID for the call"
    },
    "from_number": {
      "type": "string",
      "description": "Caller phone number in E.164 format"
    },
    "from_city": {
      "type": "string"
    },
    "from_state": {
      "type": "string"
    },
    "to_number": {
      "type": "string",
      "description": "Twilio number that received the call"
    },
    "recording_url": {
      "type": "string",
      "description": "Twilio recording URL (.mp3)"
    },
    "recording_sid": {
      "type": "string"
    },
    "recording_duration_sec": {
      "type": "number"
    },
    "transcription": {
      "type": "string",
      "description": "Auto-transcribed message"
    },
    "callback_number": {
      "type": "string",
      "description": "Callback number extracted from the message (if found)"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "called_back",
        "archived"
      ],
      "default": "new"
    },
    "follow_up_due": {
      "type": "string",
      "format": "date-time",
      "description": "24 hours after the call was received"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "call_sid",
    "from_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}