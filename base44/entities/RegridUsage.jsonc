{
  "name": "RegridUsage",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description or notes for this usage record (up to 1000 characters).",
      "maxLength": 1000
    },
    "date": {
      "type": "string",
      "description": "UTC date in YYYY-MM-DD format"
    },
    "user_email": {
      "type": "string",
      "description": "User email \u2014 empty/null for global daily counter"
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "user"
      ],
      "description": "Whether this is the platform-wide counter or a per-user counter"
    },
    "count": {
      "type": "number",
      "default": 0,
      "description": "Number of Regrid parcel pulls today"
    }
  },
  "required": [
    "date",
    "scope"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}