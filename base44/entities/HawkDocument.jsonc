{
  "name": "HawkDocument",
  "type": "object",
  "description": "Hawk Document Intelligence \u2014 an uploaded zoning or building-permit application that SiteHawk reads, explains, and fills. AI extracts every form field, explains what it asks for, pre-fills from a chosen SCIP record, and the user completes the rest via Q&A. The completed application can be e-signed, printed, and shared via a public read-only link.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description or notes for this record (up to 1000 characters).",
      "maxLength": 1000
    },
    "doc_name": {
      "type": "string",
      "description": "User label for the document (e.g. 'Hillsborough County Tower CUP Application')."
    },
    "source_file_url": {
      "type": "string",
      "description": "URL of the uploaded application file (PDF or DOCX)."
    },
    "source_file_name": {
      "type": "string",
      "description": "Original filename."
    },
    "source_file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "docx"
      ],
      "description": "Uploaded file type."
    },
    "linked_scip_id": {
      "type": "string",
      "description": "ScipRecord id the user picked to pre-fill answers from (optional)."
    },
    "linked_target_index": {
      "type": "number",
      "default": 0,
      "description": "Which parcel_targets index of the linked SCIP was used to pre-fill (0 = Target A)."
    },
    "doc_type": {
      "type": "string",
      "description": "AI-detected document type (e.g. 'Conditional Use Permit Application', 'Building Permit Application')."
    },
    "doc_summary": {
      "type": "string",
      "description": "Short plain-English summary of what this application is and what it's for."
    },
    "fields": {
      "type": "array",
      "description": "Extracted form fields. Each: { key, label, explanation, value, source('scip'|'user'|'empty'), required(bool), section, field_type }.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "scip",
              "user",
              "empty"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "section": {
            "type": "string"
          },
          "field_type": {
            "type": "string"
          }
        }
      }
    },
    "applicant_signature": {
      "type": "string",
      "description": "The applicant's e-signature \u2014 either a data-URL PNG of the drawn signature or the typed full name."
    },
    "signature_mode": {
      "type": "string",
      "enum": [
        "drawn",
        "typed"
      ],
      "description": "Whether applicant_signature is a drawn image or a typed name."
    },
    "signed_by": {
      "type": "string",
      "description": "Printed full name of the person who signed."
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the application was signed."
    },
    "share_id": {
      "type": "string",
      "description": "Short random ID used in the public read-only share URL (/hawk-doc-share?id=...)."
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "analyzing",
        "ready",
        "signed",
        "failed"
      ],
      "default": "uploaded",
      "description": "uploaded=file in; analyzing=AI reading; ready=fields extracted; signed=e-signed; failed=error."
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when analysis completed."
    }
  },
  "required": [
    "doc_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}