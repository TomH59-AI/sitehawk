{
  "name": "PropagationRunLog",
  "type": "object",
  "description": "Authenticated Propagation Explorer usage log. One row is written after each successful CloudRF/FCC run and is used for plan-aware daily quotas and auditability.",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Server-generated UUID for the propagation run."
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user id that ran the analysis."
    },
    "user_email": {
      "type": "string"
    },
    "usage_day": {
      "type": "string",
      "format": "date",
      "description": "UTC day used for the daily quota."
    },
    "tier_at_time": {
      "type": "string"
    },
    "carrier": {
      "type": "string",
      "enum": [
        "verizon",
        "att",
        "tmobile"
      ]
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "radius_miles": {
      "type": "number"
    },
    "tower_height_ft": {
      "type": "number"
    },
    "coverage_area_sq_km": {
      "type": "number"
    },
    "tower_count": {
      "type": "number"
    },
    "opportunity_count": {
      "type": "number"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "run_id",
    "user_id",
    "usage_day",
    "carrier",
    "latitude",
    "longitude",
    "radius_miles",
    "generated_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}