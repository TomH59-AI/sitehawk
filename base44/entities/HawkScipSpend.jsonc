{
  "name": "HawkScipSpend",
  "type": "object",
  "description": "One row per HawkSCIP spent. A HawkSCIP is consumed when a user runs Zoning (generateZoningPermitReport) on a site for the first time. Counting rows is the quota: free tier = lifetime count; paid tiers = count since the start of the current calendar month. Idempotent per site_key so re-running Zoning on the same site does NOT double-charge.",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who spent the HawkSCIP."
    },
    "site_key": {
      "type": "string",
      "description": "Stable site identifier used for idempotency: `{lat.toFixed(5)},{lon.toFixed(5)}` (no radius). Re-running Zoning on the same site_key reuses the existing spend row instead of charging again."
    },
    "tier_at_time": {
      "type": "string",
      "description": "The user's tier (User.tier) at the moment the HawkSCIP was spent: free | hawk_site | hawkeyes | hawkeye_apex."
    },
    "lat": {
      "type": "number",
      "description": "SARF center latitude this spend was tied to."
    },
    "lon": {
      "type": "number",
      "description": "SARF center longitude this spend was tied to."
    }
  },
  "required": [
    "user_email",
    "site_key"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}