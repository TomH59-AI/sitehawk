{
  "name": "SearchResult",
  "type": "object",
  "properties": {
    "search_id": {
      "type": "string",
      "description": "Reference to SearchHistory record"
    },
    "site_name": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "parcel_address": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_size_acres": {
      "type": "number"
    },
    "zoning_classification": {
      "type": "string"
    },
    "owner_mailing_address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "fema_risk_factor": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "match_score": {
      "type": "number",
      "description": "Score from 0-100"
    },
    "airport_iata": {
      "type": "string"
    },
    "airport_name": {
      "type": "string"
    },
    "airport_distance_miles": {
      "type": "number"
    },
    "airport_lat": {
      "type": "number"
    },
    "airport_lon": {
      "type": "number"
    },
    "cell_towers": {
      "type": "array",
      "description": "Nearest existing cell towers",
      "items": {
        "type": "object",
        "properties": {
          "operator": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "e.g. Macro, Small Cell, DAS"
          },
          "distance_miles": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "search_id",
    "site_name",
    "latitude",
    "longitude",
    "match_score"
  ]
}