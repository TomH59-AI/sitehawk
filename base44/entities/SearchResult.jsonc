{
  "name": "SearchResult",
  "type": "object",
  "properties": {
    "search_id": {
      "type": "string",
      "description": "Reference to SearchHistory record"
    },
    "site_name": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "parcel_address": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_size_acres": {
      "type": "number"
    },
    "zoning_classification": {
      "type": "string"
    },
    "owner_mailing_address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "parcel_geometry": {
      "type": "object",
      "description": "GeoJSON geometry (Polygon or MultiPolygon) of the parcel boundary"
    },
    "fema_risk_factor": {
      "type": "string",
      "description": "FEMA flood zone code (AE, X, VE, etc.) from NFHL"
    },
    "fema_zone_description": {
      "type": "string",
      "description": "Human-readable FEMA zone description"
    },
    "fema_risk_level": {
      "type": "string",
      "description": "high, minimal, or undetermined"
    },
    "fema_sfha": {
      "type": "boolean",
      "description": "True if in Special Flood Hazard Area (SFHA)"
    },
    "fema_bfe": {
      "type": "number",
      "description": "Base Flood Elevation in feet (if available)"
    },
    "fema_zone_subtype": {
      "type": "string",
      "description": "FEMA zone subtype detail"
    },
    "wind_speed_mph": {
      "type": "number",
      "description": "ASCE 7-22 design wind speed in mph (3-sec gust, Risk Category II)"
    },
    "wind_mri": {
      "type": "string",
      "description": "Mean Recurrence Interval from ASCE 7-22"
    },
    "wind_risk_level": {
      "type": "string",
      "description": "low, moderate, high, or extreme"
    },
    "in_hurricane_prone_region": {
      "type": "boolean",
      "description": "True if site is in ASCE 7-22 Hurricane Prone Region"
    },
    "in_special_wind_region": {
      "type": "boolean",
      "description": "True if site is in ASCE 7-22 Special Wind Region (local study required)"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "match_score": {
      "type": "number",
      "description": "Score from 0-100"
    },
    "airport_iata": {
      "type": "string"
    },
    "airport_name": {
      "type": "string"
    },
    "airport_distance_miles": {
      "type": "number"
    },
    "airport_lat": {
      "type": "number"
    },
    "airport_lon": {
      "type": "number"
    },
    "cell_towers": {
      "type": "array",
      "description": "Nearest existing cell towers",
      "items": {
        "type": "object",
        "properties": {
          "operator": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "distance_miles": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        }
      }
    },
    "fiber_providers": {
      "type": "array",
      "description": "FCC broadband fiber providers at this location",
      "items": {
        "type": "object",
        "properties": {
          "provider_name": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "max_download_speed": {
            "type": "number"
          },
          "max_upload_speed": {
            "type": "number"
          }
        }
      }
    },
    "has_fiber": {
      "type": "boolean",
      "description": "True if fiber broadband is available per FCC data"
    },
    "fiber_distance_miles": {
      "type": "number",
      "description": "Distance in miles to nearest mapped OSM fiber/telecom infrastructure"
    },
    "fiber_infrastructure_type": {
      "type": "string",
      "description": "Nearest mapped fiber/telecom asset type from OSM Overpass"
    },
    "fiber_operator": {
      "type": "string",
      "description": "Operator/name of nearest mapped fiber/telecom infrastructure"
    },
    "power_utility": {
      "type": "string",
      "description": "Electric utility provider name (HIFLD primary, falls back to EIA)"
    },
    "utility_type": {
      "type": "string",
      "description": "HIFLD utility type: INVESTOR OWNED, MUNICIPAL, COOPERATIVE, etc."
    },
    "utility_holding_company": {
      "type": "string",
      "description": "Parent holding company (e.g. Duke Energy Corp, Southern Company)"
    },
    "utility_website": {
      "type": "string",
      "description": "Utility website URL"
    },
    "utility_phone": {
      "type": "string",
      "description": "Utility main phone number"
    },
    "utility_control_area": {
      "type": "string",
      "description": "ISO/RTO or balancing authority code (ERCO, MISO, PJM, SOCO, etc.)"
    },
    "utility_customers": {
      "type": "number",
      "description": "Number of retail customers served by primary utility"
    },
    "utility_overlapping": {
      "type": "array",
      "description": "Other utility territories overlapping this point (co-ops, alternates)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "holding_co": {
            "type": "string"
          }
        }
      }
    },
    "fcc_block_geoid": {
      "type": "string",
      "description": "FCC census block GEOID used for lookup"
    },
    "transmission_line_distance_miles": {
      "type": "number",
      "description": "Distance in miles to nearest high-voltage transmission line"
    },
    "transmission_line_voltage": {
      "type": "string",
      "description": "Voltage class of nearest transmission line"
    },
    "wetlands_present": {
      "type": "boolean",
      "description": "True if USFWS NWI wetlands are on or adjacent to this parcel"
    },
    "wetland_types": {
      "type": "array",
      "description": "NWI wetland type(s) found",
      "items": {
        "type": "string"
      }
    },
    "wetland_proximity": {
      "type": "string",
      "description": "on-site or adjacent (~100m)"
    }
  },
  "required": [
    "search_id",
    "site_name",
    "latitude",
    "longitude",
    "match_score"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}