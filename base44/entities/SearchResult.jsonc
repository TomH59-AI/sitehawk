{
  "name": "SearchResult",
  "type": "object",
  "properties": {
    "search_id": {
      "type": "string",
      "description": "Reference to SearchHistory record"
    },
    "site_name": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "parcel_address": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_size_acres": {
      "type": "number"
    },
    "zoning_classification": {
      "type": "string"
    },
    "owner_mailing_address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "fema_risk_factor": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "match_score": {
      "type": "number",
      "description": "Score from 0-100"
    },
    "airport_iata": {
      "type": "string"
    },
    "airport_name": {
      "type": "string"
    },
    "airport_distance_miles": {
      "type": "number"
    },
    "airport_lat": {
      "type": "number"
    },
    "airport_lon": {
      "type": "number"
    },
    "cell_towers": {
      "type": "array",
      "description": "Nearest existing cell towers",
      "items": {
        "type": "object",
        "properties": {
          "operator": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "distance_miles": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        }
      }
    },
    "fiber_providers": {
      "type": "array",
      "description": "FCC broadband fiber providers at this location",
      "items": {
        "type": "object",
        "properties": {
          "provider_name": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "max_download_speed": {
            "type": "number"
          },
          "max_upload_speed": {
            "type": "number"
          }
        }
      }
    },
    "has_fiber": {
      "type": "boolean",
      "description": "True if fiber broadband is available at this location per FCC data"
    },
    "power_utility": {
      "type": "string",
      "description": "EIA electric utility provider name serving this location"
    },
    "fcc_block_geoid": {
      "type": "string",
      "description": "FCC census block GEOID used for lookup"
    },
    "transmission_line_distance_miles": {
      "type": "number",
      "description": "Distance in miles to nearest high-voltage transmission line (EIA/ArcGIS)"
    },
    "transmission_line_voltage": {
      "type": "string",
      "description": "Voltage class of nearest transmission line (e.g. 345 kV)"
    },
    "wetlands_present": {
      "type": "boolean",
      "description": "True if USFWS NWI wetlands are on or adjacent to this parcel"
    },
    "wetland_types": {
      "type": "array",
      "description": "NWI wetland type(s) found (e.g. Freshwater Emergent Wetland)",
      "items": {
        "type": "string"
      }
    },
    "wetland_proximity": {
      "type": "string",
      "description": "on-site (point inside wetland polygon) or adjacent (~100m)"
    }
  },
  "required": [
    "search_id",
    "site_name",
    "latitude",
    "longitude",
    "match_score"
  ]
}