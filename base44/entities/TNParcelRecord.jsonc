{
  "name": "TNParcelRecord",
  "type": "object",
  "description": "Normalized Tennessee parcel data for Site-Hawk Pro.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description or notes for this record (up to 1000 characters).",
      "maxLength": 1000
    },
    "state": {
      "type": "string",
      "default": "TN",
      "description": "State code for routing."
    },
    "county": {
      "type": "string",
      "description": "County name returned by TN GIS."
    },
    "parcel_id": {
      "type": "string",
      "description": "Primary parcel identifier (Map/Group/Parcel)."
    },
    "owner_name": {
      "type": "string",
      "description": "Owner name from Tennessee county GIS."
    },
    "parcel_address": {
      "type": "string",
      "description": "Situs (physical) address of the parcel."
    },
    "mailing_address": {
      "type": "string",
      "description": "Owner mailing address."
    },
    "acreage": {
      "type": "number",
      "description": "Parcel size in acres."
    },
    "zoning": {
      "type": "string",
      "description": "Zoning classification if available; otherwise 'N/A'."
    },
    "land_use": {
      "type": "string",
      "description": "Land use code or description."
    },
    "land_value": {
      "type": "number",
      "description": "Assessed land value."
    },
    "improvement_value": {
      "type": "number",
      "description": "Assessed improvement value."
    },
    "total_value": {
      "type": "number",
      "description": "Total assessed value."
    },
    "sale_date": {
      "type": "string",
      "description": "Last recorded sale date."
    },
    "latitude": {
      "type": "number",
      "description": "Centroid latitude."
    },
    "longitude": {
      "type": "number",
      "description": "Centroid longitude."
    },
    "parcel_geometry": {
      "type": "object",
      "description": "GeoJSON polygon geometry for map rendering."
    },
    "source": {
      "type": "string",
      "default": "TN-HAWK",
      "description": "Which module produced the record."
    }
  },
  "required": [
    "parcel_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}