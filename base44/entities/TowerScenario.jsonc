{
  "name": "TowerScenario",
  "type": "object",
  "description": "HawkPerch \u2014 one saved proposed-tower placement on a SiteTarget parcel, with its live feasibility result and solver configuration embedded.",
  "properties": {
    "site_target_id": {
      "type": "string",
      "description": "Linked SiteTarget id."
    },
    "name": {
      "type": "string",
      "description": "Scenario label."
    },
    "tower_lat": {
      "type": "number"
    },
    "tower_lon": {
      "type": "number"
    },
    "tower_height_ft": {
      "type": "number",
      "default": 199
    },
    "compound_width_ft": {
      "type": "number",
      "default": 100
    },
    "compound_depth_ft": {
      "type": "number",
      "default": 100
    },
    "fit_status": {
      "type": "string",
      "enum": [
        "works",
        "fails",
        "needs_review"
      ],
      "description": "HawkPerch feasibility verdict at save time."
    },
    "fit_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Why the verdict was reached."
    },
    "hawkperch_error_code": {
      "type": "string",
      "enum": [
        "ERR_EXT_P",
        "ERR_STBK",
        "ERR_FZ_S",
        "ERR_H_MIN"
      ],
      "description": "HawkPerch validation code when the location is unallowable."
    },
    "edge_distance_ft": {
      "type": "number",
      "description": "Nearest parcel-boundary distance at save time."
    },
    "max_available_height_ft": {
      "type": "number",
      "description": "Highest allowable tower height at the saved position."
    },
    "hawkperch_config": {
      "type": "object",
      "description": "Solver inputs: setbacks, height limit, PE Letter state, and engineered multiplier.",
      "properties": {
        "front_setback_ft": {
          "type": "number"
        },
        "side_setback_ft": {
          "type": "number"
        },
        "rear_setback_ft": {
          "type": "number"
        },
        "max_height_ft": {
          "type": "number"
        },
        "has_pe_letter": {
          "type": "boolean"
        },
        "fall_zone_multiplier": {
          "type": "number"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tower_lat",
    "tower_lon"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}