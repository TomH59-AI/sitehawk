      "function_name": "lookupRealieProperty",
      "description": "Look up a parcel by address, parcel ID, or coordinates \u2014 returns owner, acreage, zoning, and the parcel boundary geometry."
    },
    {
      "function_name": "analyzeTowerFit",
      "description": "Deterministic HawkPerch fit check \u2014 verifies the fall zone and compound stay fully inside the parcel for a given tower point, height, and compound size."
    },
    {
      "function_name": "femaFloodLookup",
